# ===== Banco de Dados =====
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=ezflow
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ezflow

# ===== NextAuth =====
NEXTAUTH_SECRET=change-me-to-a-random-64-char-string
NEXTAUTH_URL=http://localhost:3000

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== Evolution API =====
EVOLUTION_API_KEY=ezflow-evolution-key
# Configurado via painel admin (settings)

# ===== Mercado Pago =====
# Configurado via painel admin (settings)
# Obtenha em: https://www.mercadopago.com.br/settings/account/credentials
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx

# ===== Uploads =====
UPLOAD_DIR=./uploads
